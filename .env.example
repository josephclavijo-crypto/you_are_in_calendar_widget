GHL_API_TOKEN=replace-with-private-integration-token
GHL_API_VERSION=v3
GHL_LOCATION_ID=replace-with-subaccount-id
GHL_JOIN_FIELD_ID=replace-with-id-of-contact.rym_live__join_url
GHL_CALENDAR_TOKEN_FIELD_ID=replace-with-id-of-contact.rym_calendar_token
# Prefer an ID; if empty, the exact original merge key is searched.
GHL_REGISTRATION_VALUE_ID=
GHL_REGISTRATION_VALUE_KEY=custom_values._rym_workflows__zoom_link_1st2nd_day
# Optional fallback/override; normally leave blank to read the GHL Custom Value.
ZOOM_REGISTRATION_URL=
PUBLIC_BASE_URL=https://calendar.example.com
TOKEN_KEY=replace-with-64-hex-characters
WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_EXPIRES_AT=2026-11-01T00:00:00Z
